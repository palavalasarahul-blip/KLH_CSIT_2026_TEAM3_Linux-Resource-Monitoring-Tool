// ============================================================
// STATUS UPDATERS
// ============================================================

void updateResourceDisplay(
    GtkWidget *valueLabel,
    GtkWidget *statusLabel,
    GtkWidget *progressBar,
    double value,
    const string &labelText)
{
    if (value < 0)
    {
        gtk_label_set_text(
            GTK_LABEL(valueLabel),
            "Calculating...");

        gtk_label_set_text(
            GTK_LABEL(statusLabel),
            "Calculating");

        gtk_progress_bar_set_fraction(
            GTK_PROGRESS_BAR(progressBar),
            0.0);

        gtk_progress_bar_set_text(
            GTK_PROGRESS_BAR(progressBar),
            "Calculating");

        return;
    }

    string valueText =
        labelText + formatPercent(value);

    gtk_label_set_text(
        GTK_LABEL(valueLabel),
        valueText.c_str());

    string health =
        getStatusText(value);

    gtk_label_set_text(
        GTK_LABEL(statusLabel),
        health.c_str());

    gtk_progress_bar_set_fraction(
        GTK_PROGRESS_BAR(progressBar),
        value / 100.0);

    string percentage =
        formatPercent(value);

    gtk_progress_bar_set_text(
        GTK_PROGRESS_BAR(progressBar),
        percentage.c_str());
}

void updateSimpleValue(
    GtkWidget *label,
    const string &text)
{
    gtk_label_set_text(
        GTK_LABEL(label),
        text.c_str());
}

// ============================================================
// UPDATE MONITOR
// ============================================================

gboolean updateMonitor(gpointer data)
{
    GUIData *gui =
        static_cast<GUIData *>(data);

    // --------------------------------------------------------
    // CPU
    // --------------------------------------------------------

    double cpu =
        getCPUUsage();

    if (cpu >= 0)
    {
        addHistorySample(
            gui->cpuHistory,
            cpu);
    }

    updateResourceDisplay(
        gui->cpuLabel,
        gui->cpuStatusLabel,
        gui->cpuProgressBar,
        cpu,
        "");

    // --------------------------------------------------------
    // MEMORY
    // --------------------------------------------------------

    double memory =
        getMemoryUsage();

    addHistorySample(
        gui->memoryHistory,
        memory);

    updateResourceDisplay(
        gui->memoryLabel,
        gui->memoryStatusLabel,
        gui->memoryProgressBar,
        memory,
        "");

    // --------------------------------------------------------
    // DISK
    // --------------------------------------------------------

    double disk =
        getDiskUsage();

    updateResourceDisplay(
        gui->diskLabel,
        gui->diskStatusLabel,
        gui->diskProgressBar,
        disk,
        "");

    // --------------------------------------------------------
    // SWAP
    // --------------------------------------------------------

    double swap =
        getSwapUsage();

    updateResourceDisplay(
        gui->swapLabel,
        gui->swapStatusLabel,
        gui->swapProgressBar,
        swap,
        "");

    // --------------------------------------------------------
    // TOTAL MEMORY
    // --------------------------------------------------------

    updateSimpleValue(
        gui->totalMemoryLabel,
        getTotalMemory());

    // --------------------------------------------------------
    // CPU CORES
    // --------------------------------------------------------

    string cores =
        to_string(getCPUCores()) +
        " Cores";

    updateSimpleValue(
        gui->coresLabel,
        cores);

    // --------------------------------------------------------
    // UPTIME
    // --------------------------------------------------------

    string uptime =
        "System Uptime: " +
        getUptime();

    updateSimpleValue(
        gui->uptimeLabel,
        uptime);

    // --------------------------------------------------------
    // PROCESS COUNT
    // --------------------------------------------------------

    string processCount =
        "Running Processes: " +
        to_string(getProcessCount());

    updateSimpleValue(
        gui->processCountLabel,
        processCount);

    // --------------------------------------------------------
    // SYSTEM HEALTH
    // --------------------------------------------------------

    string health =
        getSystemHealthStatus(
            cpu >= 0 ? cpu : 0,
            memory,
            disk,
            swap);

    updateSimpleValue(
        gui->systemHealthLabel,
        "System Health: " + health);

    // --------------------------------------------------------
    // LAST UPDATED
    // --------------------------------------------------------

    updateSimpleValue(
        gui->lastUpdatedLabel,
        "Last Updated: " +
            getCurrentTimeText());

    // --------------------------------------------------------
    // TOP PROCESSES
    // --------------------------------------------------------

    vector<ProcessInfo> processes =
        getProcesses();

    if (!processes.empty())
    {
        auto topCPU =
            max_element(
                processes.begin(),
                processes.end(),
                [](const ProcessInfo &a,
                   const ProcessInfo &b)
                {
                    return a.cpu < b.cpu;
                });

        string topCPUText =
            topCPU->name +
            "  —  " +
            formatPercent(topCPU->cpu) +
            " CPU";

        updateSimpleValue(
            gui->topCPULabel,
            topCPUText);

        auto topMemory =
            max_element(
                processes.begin(),
                processes.end(),
                [](const ProcessInfo &a,
                   const ProcessInfo &b)
                {
                    return a.memory < b.memory;
                });

        string topMemoryText =
            topMemory->name +
            "  —  " +
            formatPercent(topMemory->memory) +
            " Memory";

        updateSimpleValue(
            gui->topMemoryLabel,
            topMemoryText);
    }
    else
    {
        updateSimpleValue(
            gui->topCPULabel,
            "No active process available");

        updateSimpleValue(
            gui->topMemoryLabel,
            "No active process available");
    }

    // --------------------------------------------------------
    // REDRAW GRAPHS
    // --------------------------------------------------------

    gtk_widget_queue_draw(
        gui->cpuHistoryArea);

    gtk_widget_queue_draw(
        gui->memoryHistoryArea);

    return TRUE;
}

