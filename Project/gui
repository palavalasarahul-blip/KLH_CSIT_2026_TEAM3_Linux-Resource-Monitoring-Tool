// ============================================================
// DRAWING GRAPH
// ============================================================

void drawHistoryGraph(
    GtkWidget *widget,
    cairo_t *cr,
    const vector<double> &history,
    const string &labelText)
{
    GtkAllocation alloc;
    gtk_widget_get_allocation(widget, &alloc);
    int width = alloc.width;
    int height = alloc.height;

    if (width <= 0 || height <= 0)
        return;

    // Background
    cairo_set_source_rgb(
        cr,
        0.06,
        0.10,
        0.16);

    cairo_paint(cr);

    double leftMargin = 40.0;
    double rightMargin = 15.0;
    double topMargin = 25.0;
    double bottomMargin = 25.0;

    double graphWidth =
        width -
        leftMargin -
        rightMargin;

    double graphHeight =
        height -
        topMargin -
        bottomMargin;

    // Grid
    cairo_set_line_width(cr, 1.0);

    cairo_set_source_rgba(
        cr,
        0.6,
        0.7,
        0.8,
        0.25);

    for (int i = 0; i <= 4; ++i)
    {
        double y =
            topMargin +
            graphHeight *
            (i / 4.0);

        cairo_move_to(
            cr,
            leftMargin,
            y);

        cairo_line_to(
            cr,
            width - rightMargin,
            y);
    }

    cairo_stroke(cr);

    // Y-axis labels
    cairo_set_source_rgb(
        cr,
        0.85,
        0.90,
        0.95);

    cairo_select_font_face(
        cr,
        "Sans",
        CAIRO_FONT_SLANT_NORMAL,
        CAIRO_FONT_WEIGHT_NORMAL);

    cairo_set_font_size(cr, 10.0);

    cairo_move_to(
        cr,
        5,
        topMargin + 4);

    cairo_show_text(cr, "100%");

    cairo_move_to(
        cr,
        10,
        height - bottomMargin + 4);

    cairo_show_text(cr, "0%");

    // Graph title
    cairo_set_font_size(cr, 12.0);

    cairo_move_to(
        cr,
        leftMargin,
        16);

    cairo_show_text(
        cr,
        labelText.c_str());

    // No history yet
    if (history.empty())
        return;

    // Graph line
    cairo_set_source_rgb(
        cr,
        0.20,
        0.75,
        0.95);

    cairo_set_line_width(
        cr,
        3.0);

    if (history.size() == 1)
    {
        double value = history[0];

        double x =
            leftMargin +
            graphWidth / 2.0;

        double y =
            height -
            bottomMargin -
            (value / 100.0) *
                graphHeight;

        cairo_arc(
            cr,
            x,
            y,
            4.0,
            0,
            2 * M_PI);

        cairo_fill(cr);

        return;
    }

    for (size_t i = 1;
         i < history.size();
         ++i)
    {
        double x1 =
            leftMargin +
            graphWidth *
                ((double)(i - 1) /
                 (history.size() - 1));

        double x2 =
            leftMargin +
            graphWidth *
                ((double)i /
                 (history.size() - 1));

        double y1 =
            height -
            bottomMargin -
            (history[i - 1] / 100.0) *
                graphHeight;

        double y2 =
            height -
            bottomMargin -
            (history[i] / 100.0) *
                graphHeight;

        cairo_move_to(
            cr,
            x1,
            y1);

        cairo_line_to(
            cr,
            x2,
            y2);
    }

    cairo_stroke(cr);
}

